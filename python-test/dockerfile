# Step 1: Use a base Python image
FROM python:3.9-slim

# Step 2: Set the working directory inside the container
WORKDIR /app

# Step 3: Copy pyproject.toml and install dependencies
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir .

# Step 4: Copy the rest of the application code into the container
COPY . /app

# Step 5: Expose the Flask port
EXPOSE 5000

# Step 6: Set the entry point for running the Flask app
CMD ["python", "app.py"]
